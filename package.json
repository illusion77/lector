{
  "name": "lector",
  "version": "0.1.0",
  "private": true,
  "description": "Sentence-by-sentence read-aloud for any web page, with an on-device neural voice.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "ios": "open safari/Lector/Lector.xcodeproj"
  },
  "dependencies": {
    "phonon-tts": "0.7.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/illusion77/lector.git"
  }
}
